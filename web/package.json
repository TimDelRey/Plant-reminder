{
  "name": "plant-care-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../internal/api/openapi.yaml -o src/api/schema.d.ts",
    "dev": "npm run gen:api && vite",
    "build": "npm run gen:api && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
