# Скопируйте в .env и заполните. .env в репозиторий не попадает.
APP_ENV=dev                     # dev | prod
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
COOKIE_SECURE=false             # в проде true (HTTPS)

# PostgreSQL
DATABASE_URL=postgres://plantcare:plantcare@localhost:5433/plantcare?sslmode=disable
POSTGRES_PASSWORD=plantcare     # только для docker-compose

# Время уведомлений (местное время пользователя, час 0-23)
NOTIFY_HOUR=9
SCHEDULER_INTERVAL=1m
OUTBOX_INTERVAL=5s
OUTBOX_MAX_ATTEMPTS=4

# SMTP для писем сброса пароля (локально: Mailpit, UI на :8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Уход за растениями <no-reply@localhost>"

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# VK (сообщество + Callback API)
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_COMMUNITY_SCREEN_NAME=
VK_CONFIRMATION_CODE=
VK_CALLBACK_SECRET=

# MAX
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=

# Perenual (подбор ухода по названию растения): https://perenual.com/user/api — бесплатный ключ.
# Бесплатный тариф: 100 запросов/сутки, данные по видам 1–3000, без коммерческого использования. Пусто — справочник недоступен, события добавляются вручную.
PERENUAL_API_KEY=
PERENUAL_BASE_URL=

# Только dev: для каналов без токена использовать "заглушку", которая пишет сообщение в лог
# и в таблицу dev_outbox. В prod игнорируется.
DEV_FAKE_SENDERS=true

# Serverless (Yandex Cloud Serverless Containers)
# BACKGROUND_WORKERS=false отключает фоновые горутины; планировщик и очередь отправки запускает внешний
# таймер (раз в час) вызовом POST /internal/run-jobs. Секрет — в заголовке X-Internal-Secret или в payload таймера.
BACKGROUND_WORKERS=true
INTERNAL_SECRET=
# Размер пула соединений с БД (в serverless держите небольшим: экземпляров может быть несколько)
DB_MAX_CONNS=20
# PORT задаёт платформа (если HTTP_ADDR не указан, слушаем :$PORT)
